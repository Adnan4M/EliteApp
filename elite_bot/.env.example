# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional: used automatically if GEMINI_MODEL hits a quota/availability error.
# Each free-tier model has its own daily quota, so a fallback multiplies it.
GEMINI_MODEL_FALLBACK=
ADMIN_IDS=
DATABASE_URL=sqlite:///elite.db
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=
APP_JWT_SECRET=
APP_ADMIN_KEY=
SUPPORT_TELEGRAM=https://t.me/EliteSupport
